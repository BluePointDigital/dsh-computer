# OPERATOR TEMPLATE ONLY. Replace ALL example names/addresses before deployment.
# Pin/review upstream acme-dns v2.0.2 or a reviewed later release. Do not expose
# this API without the matching public authoritative NS/A records and valid TLS.
[general]
listen = "0.0.0.0:53"
protocol = "both"
domain = "auth.validation.example"
nsname = "auth.validation.example"
nsadmin = "ops.validation.example"
records = [
  "auth.validation.example. A 192.0.2.53",
  "auth.validation.example. NS auth.validation.example.",
]
debug = false

[database]
engine = "sqlite"
connection = "/var/lib/acme-dns/acme-dns.db"

[api]
ip = "0.0.0.0"
port = "443"
# Registration must be restricted by network policy/edge to operators; do not
# offer anonymous unbounded public account creation. Alternatively enroll during
# a maintenance window, then set this true.
disable_registration = false
tls = "letsencrypt"
acme_cache_dir = "/var/lib/acme-dns/api-certs"
notification_email = "ops@validation.example"
corsorigins = []
# Never trust arbitrary client-supplied forwarding headers for IP restrictions.
use_header = false

[logconfig]
loglevel = "warn"
logtype = "stdout"
logformat = "json"
